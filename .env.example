# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
SITE_NAME=我的个人主页
SITE_URL=https://blog.gianniiss.top
SITE_DOMAIN=gianniiss.top

# 注册邮件与人机验证；留空时开发服务器只会把验证码打印到日志。
RESEND_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub OAuth App；回调地址示例：https://blog.gianniiss.top/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
# GitHub OAuth 专用的本机 Mihomo HTTP 代理；生产示例：
# http://blog-github:replace-with-proxy-password@host.docker.internal:7890
GITHUB_PROXY_URL=
# 固定使用 GitHub 官方 token 地址。
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token

# AI 日报配置（兼容任何 OpenAI 接口格式：DeepSeek / OpenAI / Ollama / 豆包 等）
AI_API_KEY=your-api-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
